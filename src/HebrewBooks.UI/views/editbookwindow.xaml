<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="HebrewBooks.UI.Views.EditBookWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Title="{x:Static res:SharedStrings.EditBookTitle}" Icon="/Resources/HebrewBooks.ico" Width="700" Height="600" WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" xmlns:views="clr-namespace:HebrewBooks.UI.Views" FlowDirection="{m:LangFlow}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="{x:Static res:SharedStrings.EditBookTitle}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="/Resources/HebrewBooks.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
    <ScrollViewer Grid.Row="1" Padding="24,16,24,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelFileId}" VerticalAlignment="Center" Margin="0,8" FontWeight="SemiBold" />
        <ui:TextBox Grid.Row="0" Grid.Column="1" Margin="0,8" Text="{Binding Book.FileID}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelTitle}" VerticalAlignment="Center" Margin="0,8" FontWeight="SemiBold" />
        <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,8" Text="{Binding Book.BookName}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelAuthor}" VerticalAlignment="Center" Margin="0,8" FontWeight="SemiBold" />
        <ui:TextBox Grid.Row="2" Grid.Column="1" Margin="0,8" Text="{Binding Book.AuthorName}" />
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelPrintPlace}" VerticalAlignment="Center" Margin="0,8" FontWeight="SemiBold" />
        <ui:TextBox Grid.Row="3" Grid.Column="1" Margin="0,8" Text="{Binding Book.PrintPlace}" />
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelPrintYear}" VerticalAlignment="Center" Margin="0,8" FontWeight="SemiBold" />
        <ui:TextBox Grid.Row="4" Grid.Column="1" Margin="0,8" Text="{Binding Book.PrintYear}" />
        <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelPages}" VerticalAlignment="Center" Margin="0,8" FontWeight="SemiBold" />
        <ui:NumberBox Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="99999" Margin="0,8" Value="{Binding Book.CountPage}" />
        <TextBlock Grid.Row="6" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelFolder}" VerticalAlignment="Center" Margin="0,8" FontWeight="SemiBold" />
        <ui:TextBox Grid.Row="6" Grid.Column="1" Margin="0,8" Text="{Binding Book.Folder}" />
        <TextBlock Grid.Row="7" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelCategories}" VerticalAlignment="Center" Margin="0,8" FontWeight="SemiBold" />
        <ui:TextBox Grid.Row="7" Grid.Column="1" Margin="0,8" Text="{Binding Book.Categories}" />
        <TextBlock Grid.Row="8" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelDescription}" VerticalAlignment="Top" Margin="0,12" FontWeight="SemiBold" />
        <ui:TextBox Grid.Row="8" Grid.Column="1" Margin="0,12,0,8" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" VerticalScrollBarVisibility="Auto" Text="{Binding Book.Description}" />
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource ControlFillColorTertiaryBrush}" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Foreground="#FFFF0000" VerticalAlignment="Center" Text="{Binding ErrorMessage}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ui:Button Content="{x:Static res:SharedStrings.ButtonCancel}" MinWidth="100" Margin="0,0,8,0" Click="OnCancel" />
          <ui:Button Content="{x:Static res:SharedStrings.ButtonOk}" Appearance="Primary" MinWidth="100" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>