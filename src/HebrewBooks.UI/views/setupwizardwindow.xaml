<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="HebrewBooks.UI.Views.SetupWizardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:HebrewBooks.UI.ViewModels" xmlns:conv="clr-namespace:HebrewBooks.UI.Converters" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Title="{x:Static res:SharedStrings.S476}" Icon="/Resources/HebrewBooks.ico" Width="720" Height="600" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" xmlns:views="clr-namespace:HebrewBooks.UI.Views" FlowDirection="{m:LangFlow}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <conv:StringNotEmptyToVisibility x:Key="StrNotEmpty" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="{x:Static res:SharedStrings.S476}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="/Resources/HebrewBooks.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
    <Grid Row="1" Margin="24,12,24,20" Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVis}}">
      <StackPanel VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="Warning24" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
        <TextBlock Text="{x:Static res:SharedStrings.S477}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,8" />
        <TextBlock TextAlignment="Center" TextWrapping="Wrap" Opacity="0.8" MaxWidth="520" Text="{x:Static res:SharedStrings.S478}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
          <ui:Button Content="{x:Static res:SharedStrings.S479}" Appearance="Primary" Padding="20,8" Margin="0,0,8,0" Command="{Binding RetryDetectCommand}" />
          <ui:Button Content="{x:Static res:SharedStrings.S480}" Padding="18,8" Margin="0,0,8,0" Command="{Binding BrowseCommand}" />
          <ui:Button Content="{x:Static res:SharedStrings.S481}" Padding="18,8" Command="{Binding ExitCommand}" />
        </StackPanel>
        <TextBlock TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="520" Margin="0,12,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding RetryMessage}" Visibility="{Binding RetryMessage, Converter={StaticResource StrNotEmpty}}" />
        <Border Margin="0,22,0,0" Padding="16" CornerRadius="8" MaxWidth="520" HorizontalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{x:Static res:SharedStrings.S482}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8" FontSize="12" Margin="0,0,0,12" Text="{x:Static res:SharedStrings.S483}" />
            <ui:Button Content="{x:Static res:SharedStrings.S484}" Appearance="Primary" HorizontalAlignment="Center" Padding="20,8" Command="{Binding GoOnlineCommand}" />
            <CheckBox Content="{x:Static res:SharedStrings.S485}" HorizontalAlignment="Center" Margin="0,10,0,0" IsChecked="{Binding RememberOnlineChoice, Mode=TwoWay}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <Grid Row="1" Margin="24,12,24,16" Visibility="{Binding IsChooseTier, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="{x:Static res:SharedStrings.S486}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Margin="0,4,0,8" Opacity="0.7" FontSize="12">
        <Run FontFamily="Consolas, monospace" Text="{Binding TargetFolder, Mode=OneWay}" />
        <LineBreak />
        <Run Text="{Binding FreeSpaceText, Mode=OneWay}" />
      </TextBlock>
      <ListBox Grid.Row="2" BorderThickness="0" Background="#00FFFFFF" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Tiers}" SelectedItem="{Binding SelectedTier, Mode=TwoWay}">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="IsEnabled" Value="{Binding Fits}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card Padding="14">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding Title}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,4" FontSize="12" Text="{Binding Subtitle}" />
                <TextBlock FontSize="12" Opacity="0.9" Text="{Binding SizeText}" />
                <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding FitWarning}" Visibility="{Binding FitWarning, Converter={StaticResource StrNotEmpty}}" />
              </StackPanel>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
      <CheckBox Grid.Row="3" Margin="2,4,0,0" Content="{x:Static res:SharedStrings.S487}" IsChecked="{Binding BuildIndexLocally}" Visibility="{Binding ShowBuildLocally, Converter={StaticResource BoolToVis}}" />
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
        <ui:Button Content="{x:Static res:SharedStrings.S363}" Appearance="Primary" Padding="22,8" Margin="0,0,8,0" Command="{Binding StartProvisionCommand}" />
        <ui:Button Content="{x:Static res:SharedStrings.S488}" Padding="18,8" Command="{Binding BackCommand}" />
      </StackPanel>
    </Grid>
    <Grid Row="1" Margin="24,12,24,16" Visibility="{Binding IsProvisioning, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="{x:Static res:SharedStrings.S489}" FontSize="18" FontWeight="SemiBold" />
      <ProgressBar Grid.Row="1" Margin="0,12,0,8" Height="8" Value="{Binding BytesDone}" Maximum="{Binding BytesTotal}" />
      <TextBlock Grid.Row="2" TextWrapping="Wrap" Opacity="0.85" Text="{Binding StatusText}" />
      <ui:Card Grid.Row="3" Margin="0,12,0,0" Padding="0">
        <ListBox BorderThickness="0" FontFamily="Consolas, Cascadia Code, monospace" FontSize="12" ItemsSource="{Binding Logs}">
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="{x:Type ListBoxItem}">
              <Setter Property="Padding" Value="8,2" />
              <Setter Property="Focusable" Value="False" />
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ListBox>
      </ui:Card>
      <ui:Button Grid.Row="4" Content="{x:Static res:SharedStrings.S490}" Appearance="Caution" Padding="18,8" Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding CancelProvisionCommand}" />
    </Grid>
  </Grid>
</ui:FluentWindow>