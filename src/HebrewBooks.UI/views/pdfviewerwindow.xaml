<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="HebrewBooks.UI.Views.PdfViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:HebrewBooks.UI.Controls" xmlns:conv="clr-namespace:HebrewBooks.UI.Converters" xmlns:beh="clr-namespace:HebrewBooks.UI.Behaviors" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Icon="/Resources/HebrewBooks.ico" Width="1200" Height="850" MinWidth="800" MinHeight="500" WindowState="Maximized" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" xmlns:views="clr-namespace:HebrewBooks.UI.Views" Title="{Binding BookTitle}" FlowDirection="{m:LangFlow}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:InverseBooleanToVisibility x:Key="InverseBoolToVisConverter" />
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="{Binding BookTitle}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="/Resources/HebrewBooks.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
    <Border Name="InBookChromeBar" Grid.Row="1" Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Background="{DynamicResource ControlFillColorTertiaryBrush}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox Name="InBookBox" Grid.Column="0" beh:SelectAllOnFocus.Enabled="True" PlaceholderText="{x:Static res:SharedStrings.S323}" Padding="8" Margin="0,0,8,0" Text="{Binding InBookSearchText, UpdateSourceTrigger=PropertyChanged}">
            <UIElement.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SearchInBookCommand}" />
            </UIElement.InputBindings>
          </ui:TextBox>
          <ui:Button Grid.Column="1" Content="{x:Static res:SharedStrings.S324}" Appearance="Primary" MinWidth="70" Margin="0,0,4,0" Command="{Binding SearchInBookCommand}" />
          <ui:Button Grid.Column="2" Content="▶" MinWidth="36" Margin="0,0,4,0" Command="{Binding PrevHitCommand}" />
          <ui:Button Grid.Column="3" Content="◀" MinWidth="36" Margin="0,0,6,0" Command="{Binding NextHitCommand}" />
          <ComboBox Grid.Column="4" ToolTip="{x:Static res:SharedStrings.S298}" Padding="8,4" MinWidth="92" MaxDropDownHeight="320" Margin="0,0,8,0" ItemsSource="{Binding InBookHitPages}" SelectedItem="{Binding SelectedHitPage, Mode=TwoWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat={x:Static res:SharedStrings.S9310}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ComboBox>
          <ui:Button Grid.Column="5" MinWidth="36" Margin="0,0,8,0" ToolTip="{x:Static res:SharedStrings.S325}" Click="OnOpenExternalClick">
            <ui:SymbolIcon Symbol="Open24" />
          </ui:Button>
          <TextBlock Grid.Column="6" VerticalAlignment="Center" Opacity="0.85" FontSize="12" FontWeight="SemiBold" MinWidth="60" TextAlignment="Center" Text="{Binding MatchPositionText}" />
          <TextBlock Grid.Column="7" VerticalAlignment="Center" Opacity="0.7" FontSize="12" MinWidth="160" TextAlignment="Center" Margin="8,0,0,0" Text="{Binding InBookSearchStatus}" />
          <ui:Button Name="PinChromeBtn" Grid.Column="8" MinWidth="32" Margin="4,0,0,0" Padding="4,2">
            <ui:SymbolIcon Name="PinChromeIcon" Symbol="Pin24" />
          </ui:Button>
          <ui:Button Name="RegionCopyBtn" Grid.Column="9" MinWidth="32" Margin="2,0,0,0" Padding="4,2" ToolTip="{x:Static res:SharedStrings.S292}">
            <ui:SymbolIcon Symbol="Image24" />
          </ui:Button>
          <ui:Button Name="RegionCopyTextBtn" Grid.Column="10" MinWidth="32" Margin="2,0,0,0" Padding="4,2" ToolTip="{x:Static res:SharedStrings.S293}">
            <ui:SymbolIcon Symbol="TextAlignJustify24" />
          </ui:Button>
        </Grid>
        <Grid Margin="0,6,0,0" Visibility="{Binding ShowHitPagesStrip, Converter={StaticResource BoolToVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold" Opacity="0.8" Text="{Binding InBookHitPages.Count, StringFormat={x:Static res:SharedStrings.S9312}}" />
          <ui:Button Grid.Column="1" Content="‹" Tag="-1" MinWidth="28" Padding="0" Margin="0,0,2,0" ToolTip="{x:Static res:SharedStrings.S299}" Click="OnHitStripScrollClick" />
          <ListBox Name="HitStripList" Grid.Column="2" Style="{StaticResource HitPagesStrip}" beh:ListBoxScrollIntoView.Enabled="True" ItemsSource="{Binding InBookHitPages}" SelectedItem="{Binding SelectedHitPage, Mode=TwoWay}" />
          <ui:Button Grid.Column="3" Content="›" Tag="1" MinWidth="28" Padding="0" Margin="2,0,0,0" ToolTip="{x:Static res:SharedStrings.S299}" Click="OnHitStripScrollClick" />
        </Grid>
      </StackPanel>
    </Border>
    <ctl:PdfJsHost x:Name="PdfView" Grid.Row="2" />
    <Border Grid.Row="3" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0">
      <ctl:CreditBar />
    </Border>
  </Grid>
</ui:FluentWindow>