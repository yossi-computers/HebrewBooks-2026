<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="HebrewBooks.UI.Views.PrintWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Title="{x:Static res:SharedStrings.S181}" Width="1080" Height="780" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" xmlns:views="clr-namespace:HebrewBooks.UI.Views" FlowDirection="{m:LangFlow}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="{x:Static res:SharedStrings.S181}" ShowMaximize="True" ShowMinimize="True" />
    <Grid Row="1" Margin="12,4,12,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Padding="14" Background="{DynamicResource ControlFillColorTertiaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="{x:Static res:SharedStrings.S333}" FontWeight="SemiBold" Margin="0,0,0,4" Visibility="{m:HideInProtectMode}" />
            <ComboBox Name="PrinterBox" DisplayMemberPath="Name" Padding="8,6" Margin="0,0,0,12" Visibility="{m:HideInProtectMode}" />
            <TextBlock Text="{x:Static res:SharedStrings.S334}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ui:NumberBox Name="CopiesBox" Value="1" Minimum="1" Maximum="99" FlowDirection="LeftToRight" HorizontalAlignment="Left" MinWidth="110" Margin="0,0,0,12" />
            <TextBlock Text="{x:Static res:SharedStrings.S335}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox Name="RangeBox" Padding="8,6" SelectedIndex="0" Margin="0,0,0,6">
              <ComboBoxItem Content="{x:Static res:SharedStrings.S336}" />
              <ComboBoxItem Content="{x:Static res:SharedStrings.S337}" />
            </ComboBox>
            <StackPanel Name="RangePanel" Orientation="Horizontal" Margin="0,0,0,12" IsEnabled="False">
              <TextBlock Text="{x:Static res:SharedStrings.S338}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ui:NumberBox Name="FromBox" Value="1" Minimum="1" MinWidth="120" ClearButtonEnabled="False" FlowDirection="LeftToRight" />
              <TextBlock Text="{x:Static res:SharedStrings.S339}" VerticalAlignment="Center" Margin="12,0,6,0" />
              <ui:NumberBox Name="ToBox" Value="1" Minimum="1" MinWidth="120" ClearButtonEnabled="False" FlowDirection="LeftToRight" />
            </StackPanel>
            <TextBlock Text="{x:Static res:SharedStrings.S340}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox Name="NupBox" Padding="8,6" SelectedIndex="0" Margin="0,0,0,12">
              <ComboBoxItem Content="{x:Static res:SharedStrings.S341}" Tag="1" />
              <ComboBoxItem Content="{x:Static res:SharedStrings.S342}" Tag="2" />
              <ComboBoxItem Content="4" Tag="4" />
              <ComboBoxItem Content="6" Tag="6" />
              <ComboBoxItem Content="8" Tag="8" />
              <ComboBoxItem Content="9" Tag="9" />
            </ComboBox>
            <TextBlock Text="{x:Static res:SharedStrings.S343}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox Name="OrientBox" Padding="8,6" SelectedIndex="0" Margin="0,0,0,12">
              <ComboBoxItem Content="{x:Static res:SharedStrings.S344}" />
              <ComboBoxItem Content="{x:Static res:SharedStrings.S345}" />
            </ComboBox>
            <TextBlock Text="{x:Static res:SharedStrings.S346}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox Name="OrderBox" Padding="8,6" SelectedIndex="0" Margin="0,0,0,12">
              <ComboBoxItem Content="{x:Static res:SharedStrings.S347}" Tag="0" />
              <ComboBoxItem Content="{x:Static res:SharedStrings.S348}" Tag="1" />
              <ComboBoxItem Content="{x:Static res:SharedStrings.S349}" Tag="2" />
              <ComboBoxItem Content="{x:Static res:SharedStrings.S350}" Tag="3" />
            </ComboBox>
            <TextBlock Text="{x:Static res:SharedStrings.S351}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox Name="DpiBox" Padding="8,6" SelectedIndex="0" ToolTip="{x:Static res:SharedStrings.S352}">
              <ComboBoxItem Content="{x:Static res:SharedStrings.S353}" Tag="0" />
              <ComboBoxItem Content="300" Tag="300" />
              <ComboBoxItem Content="{x:Static res:SharedStrings.S354}" Tag="200" />
              <ComboBoxItem Content="{x:Static res:SharedStrings.S355}" Tag="150" />
            </ComboBox>
            <TextBlock Name="StatusText" Margin="0,16,0,0" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Column="1" Margin="12,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox Name="Thumbs" Grid.Column="0" SelectedIndex="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" ItemsSource="{Binding Sheets}" SelectionChanged="OnSheetSelected">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2,6">
                <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Background="#FFFFFFFF">
                  <Image Width="138" Stretch="Uniform" Source="{Binding Image}" />
                </Border>
                <TextBlock HorizontalAlignment="Center" FontSize="11" Opacity="0.7" Margin="0,3,0,0" Text="{Binding Caption}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <Border Grid.Column="1" Margin="12,0,0,0" Background="{DynamicResource ControlFillColorTertiaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
          <Grid>
            <Image Name="LargeView" Stretch="Uniform" Margin="16" />
            <ui:ProgressRing Name="Busy" IsIndeterminate="True" Width="40" Height="40" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,8,16,16">
      <ui:Button Name="PrintBtn" Content="{x:Static res:SharedStrings.S356}" Appearance="Primary" MinWidth="120" Margin="0,0,8,0" Click="OnPrint" />
      <ui:Button Name="SavePdfBtn" Content="{x:Static res:SharedStrings.S357}" MinWidth="140" Margin="0,0,8,0" ToolTip="{x:Static res:SharedStrings.S358}" Click="OnSavePdf" />
      <ui:Button Content="{x:Static res:SharedStrings.S359}" MinWidth="120" Click="OnCancel" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>