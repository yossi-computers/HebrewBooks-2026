<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="HebrewBooks.UI.Views.PersonalCorpusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:HebrewBooks.UI.ViewModels" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Title="{x:Static res:SharedStrings.S55}" Icon="/Resources/HebrewBooks.ico" Width="780" Height="560" WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" xmlns:views="clr-namespace:HebrewBooks.UI.Views" FlowDirection="{m:LangFlow}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="{x:Static res:SharedStrings.S55}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="/Resources/HebrewBooks.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
    <ui:Card Grid.Row="1" Margin="16,8,16,8" Padding="16">
      <StackPanel>
        <TextBlock Text="{x:Static res:SharedStrings.S326}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Padding="8,6" Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="4" VerticalAlignment="Center">
            <TextBlock FontFamily="Consolas, Cascadia Code, monospace" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding FolderPath}" />
          </Border>
          <ui:Button Grid.Column="1" Content="{x:Static res:SharedStrings.S327}" Margin="8,0,0,0" Padding="14,6" Command="{Binding OpenFolderCommand}" />
        </Grid>
        <TextBlock Margin="0,8,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Text="{x:Static res:SharedStrings.S328}" />
      </StackPanel>
    </ui:Card>
    <ui:Card Grid.Row="2" Margin="16,0,16,8" Padding="16">
      <StackPanel>
        <TextBlock Text="{x:Static res:SharedStrings.S329}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ProgressBar Height="6" Margin="0,0,0,8" Value="{Binding ScanProgressDone}" Maximum="{Binding ScanProgressTotal}" Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}" />
        <StackPanel Orientation="Horizontal">
          <ui:Button Content="{x:Static res:SharedStrings.S330}" Appearance="Primary" Padding="18,6" MinWidth="140" Margin="0,0,8,0" Command="{Binding ScanCommand}" />
          <ui:Button Content="{x:Static res:SharedStrings.S47}" Appearance="Caution" Padding="14,6" MinWidth="120" Margin="0,0,8,0" Command="{Binding CancelScanCommand}" />
          <ui:Button Content="{x:Static res:SharedStrings.S29}" Padding="14,6" MinWidth="140" ToolTip="{x:Static res:SharedStrings.S331}" Command="{Binding BuildIndexCommand}" />
        </StackPanel>
      </StackPanel>
    </ui:Card>
    <ui:Card Grid.Row="3" Margin="16,0,16,8" Padding="0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ControlFillColorTertiaryBrush}" Padding="10,6">
          <TextBlock Text="{x:Static res:SharedStrings.S332}" FontWeight="SemiBold" />
        </Border>
        <ListBox BorderThickness="0" FontFamily="Consolas, Cascadia Code, monospace" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding Logs}">
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="{x:Type ListBoxItem}">
              <Setter Property="Padding" Value="8,2" />
              <Setter Property="Focusable" Value="False" />
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ListBox>
      </DockPanel>
    </ui:Card>
    <Border Grid.Row="4" Background="{DynamicResource ControlFillColorTertiaryBrush}" Padding="16,10">
      <TextBlock Opacity="0.7" FontSize="12" Text="{Binding FolderPath, StringFormat={x:Static res:SharedStrings.S9314}}" />
    </Border>
  </Grid>
</ui:FluentWindow>