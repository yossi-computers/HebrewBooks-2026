        <ui:Button Name="OkButton" Content="{x:Static res:SharedStrings.S503}" Appearance="Primary" MinWidth="90" IsDefault="True" Click="OnOk" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>