<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="HebrewBooks.UI.Views.DeleteBookWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Title="{x:Static res:SharedStrings.S9}" Icon="/Resources/HebrewBooks.ico" Width="560" Height="480" MinWidth="480" MinHeight="380" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" xmlns:views="clr-namespace:HebrewBooks.UI.Views" FlowDirection="{m:LangFlow}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="{x:Static res:SharedStrings.S9}" ShowMaximize="False" ShowMinimize="False">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="/Resources/HebrewBooks.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
    <Grid Row="1" Margin="24,16,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
        <ui:SymbolIcon Symbol="Warning24" FontSize="24" Foreground="#FFD13438" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Text="{x:Static res:SharedStrings.S10}" FontSize="18" FontWeight="Bold" Foreground="#FFD13438" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13">
        <Run Text="{x:Static res:SharedStrings.S9293}" />
        <Run FontWeight="SemiBold" Text="{x:Static res:SharedStrings.S11}" />
        <Run Text="{x:Static res:SharedStrings.S9294}" />
        <Run FontWeight="SemiBold" Text="{x:Static res:SharedStrings.S12}" /> <Run Text="{x:Static res:SharedStrings.S13}" /><Run FontWeight="SemiBold" Text="{x:Static res:SharedStrings.S14}" /><Run Text="{x:Static res:SharedStrings.S9295}" /></TextBlock>
      <Border Grid.Row="2" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource ControlFillColorTertiaryBrush}" Padding="12,8" Margin="0,0,0,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
          <TextBlock TextWrapping="Wrap" FontSize="13" Text="{Binding BookNamesDisplay}" />
        </ScrollViewer>
      </Border>
      <TextBlock Grid.Row="3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Text="{Binding ChallengeText}" />
      <ui:TextBox Grid.Row="4" PlaceholderText="{x:Static res:SharedStrings.S15}" FontSize="14" Padding="10,6" Margin="0,0,0,10" Text="{Binding AnswerText, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Grid.Row="5" TextWrapping="Wrap" FontSize="12" Opacity="0.85" Margin="0,4,0,0" Text="{Binding StatusText}" />
    </Grid>
    <Grid Row="2" Margin="24,8,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:Button Grid.Column="0" Content="{x:Static res:SharedStrings.S16}" Appearance="Danger" MinWidth="100" Padding="14,8" Command="{Binding ConfirmCommand}" />
      <ui:Button Grid.Column="1" Content="{x:Static res:SharedStrings.S17}" Appearance="Secondary" MinWidth="100" Padding="14,8" Margin="8,0,0,0" Click="OnCloseClick" />
    </Grid>
  </Grid>
</ui:FluentWindow>