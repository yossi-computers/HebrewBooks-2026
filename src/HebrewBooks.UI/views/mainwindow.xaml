<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="HebrewBooks.UI.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:views="clr-namespace:HebrewBooks.UI.Views" xmlns:ctl="clr-namespace:HebrewBooks.UI.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Icon="/Resources/HebrewBooks.ico" Width="1280" Height="800" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Title="{Binding AppTitle}" FlowDirection="{m:LangFlow}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" ShowMaximize="True" ShowMinimize="True" ShowClose="True" Title="{Binding AppTitle}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="/Resources/HebrewBooks.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
    <StackPanel Grid.Row="1">
      <ctl:DonateStrip />
      <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" BorderThickness="0,1,0,1" Padding="16,8" Visibility="{Binding DataRootMissing, Converter={StaticResource BoolToVis}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Static res:SharedStrings.S315}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" Text="{Binding DataRootMissingReason}" />
          </StackPanel>
          <ui:Button Grid.Column="2" Appearance="Primary" MinWidth="140" Padding="10,6" Command="{Binding RefreshDataRootCommand}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" />
              <TextBlock Text="{x:Static res:SharedStrings.S316}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:Button>
        </Grid>
      </Border>
      <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="0,1,0,1" Padding="16,8" Visibility="{Binding UpdateBannerVisible, Converter={StaticResource BoolToVis}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon Grid.Column="0" Symbol="ArrowSync24" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Text="{Binding UpdateBannerText}" />
            <TextBlock Text="{x:Static res:SharedStrings.S317}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" Margin="0,8,0,2" Visibility="{Binding HasUpdateReleaseNotes, Converter={StaticResource BoolToVis}}" />
            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasUpdateReleaseNotes, Converter={StaticResource BoolToVis}}">
              <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="{Binding UpdateReleaseNotes}" />
            </ScrollViewer>
            <ProgressBar Maximum="100" Height="4" Margin="0,6,0,0" Value="{Binding UpdateDownloadProgress}" Visibility="{Binding UpdateDownloading, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <ui:Button Grid.Column="2" Appearance="Primary" MinWidth="160" Margin="0,0,8,0" Command="{Binding DownloadAndInstallUpdateCommand}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                <Setter Property="Content" Value="הורד והתקן" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding UpdateReady}">
                    <Setter Property="Content" Value="הפעל מחדש כעת" />
                  </DataTrigger>
                  <DataTrigger Value="True" Binding="{Binding UpdateDownloading}">
                    <Setter Property="Content" Value="מוריד…" />
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </ui:Button>
          <ui:Button Grid.Column="3" Appearance="Transparent" ToolTip="{x:Static res:SharedStrings.S318}" Padding="6" Command="{Binding DismissUpdateCommand}">
            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
          </ui:Button>
        </Grid>
      </Border>
    </StackPanel>
    <Grid Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Name="ImmersiveRailCol" Width="0" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ui:NavigationView Name="Nav" Grid.Column="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" OpenPaneLength="240">
        <ui:NavigationView.MenuItems>
          <ui:NavigationViewItem Name="LibraryNavItem" Content="{x:Static res:SharedStrings.MenuLibrary}" TargetPageType="{x:Type views:LibraryPage}">
            <ui:NavigationViewItem.Icon>
              <ui:SymbolIcon Symbol="Library24" />
            </ui:NavigationViewItem.Icon>
          </ui:NavigationViewItem>
          <ui:NavigationViewItem Name="SearchNavItem" Content="{x:Static res:SharedStrings.MenuViewSearch}" TargetPageType="{x:Type views:SearchPage}">
            <ui:NavigationViewItem.Icon>
              <ui:SymbolIcon Symbol="Search24" />
            </ui:NavigationViewItem.Icon>
          </ui:NavigationViewItem>
          <ui:NavigationViewItem Content="{x:Static res:SharedStrings.MenuMadafManager}" TargetPageType="{x:Type views:MadafManagerPage}" Visibility="{m:HideInProtectMode}">
            <ui:NavigationViewItem.Icon>
              <ui:SymbolIcon Symbol="Stack24" />
            </ui:NavigationViewItem.Icon>
          </ui:NavigationViewItem>
          <ui:NavigationViewItem Content="{x:Static res:SharedStrings.MenuDownloader}" TargetPageType="{x:Type views:DownloaderPage}" Visibility="{m:HideOnNetworkOrProtectMode}">
            <ui:NavigationViewItem.Icon>
              <ui:SymbolIcon Symbol="ArrowDownload24" />
            </ui:NavigationViewItem.Icon>
          </ui:NavigationViewItem>
          <ui:NavigationViewItem Name="FavoritesNavItem" Content="{x:Static res:SharedStrings.S319}">
            <ui:NavigationViewItem.Icon>
              <ui:SymbolIcon Symbol="Star24" />
            </ui:NavigationViewItem.Icon>
          </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>
        <ui:NavigationView.FooterMenuItems>
          <ui:NavigationViewItem Content="{x:Static res:SharedStrings.MenuSettings}" TargetPageType="{x:Type views:SettingsPage}" Visibility="{m:HideInProtectMode}">
            <ui:NavigationViewItem.Icon>
              <ui:SymbolIcon Symbol="Settings24" />
            </ui:NavigationViewItem.Icon>
          </ui:NavigationViewItem>
          <ui:NavigationViewItem Content="{x:Static res:SharedStrings.MenuHelp}" TargetPageType="{x:Type views:HelpPage}">
            <ui:NavigationViewItem.Icon>
              <ui:SymbolIcon Symbol="QuestionCircle24" />
            </ui:NavigationViewItem.Icon>
          </ui:NavigationViewItem>
        </ui:NavigationView.FooterMenuItems>
      </ui:NavigationView>
      <Border Name="ImmersiveNavStrip" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1,0,1,0" Visibility="Collapsed">
        <StackPanel Orientation="Vertical" Margin="0,14,0,0">
          <ui:Button Appearance="Transparent" Margin="6,4" Padding="8" ToolTip="{x:Static res:SharedStrings.S320}" Click="OnImmersiveNavLibrary">
            <ui:SymbolIcon Symbol="Library24" FontSize="20" />
          </ui:Button>
          <ui:Button Appearance="Transparent" Margin="6,4" Padding="8" ToolTip="{x:Static res:SharedStrings.S245}" Click="OnImmersiveNavSearch">
            <ui:SymbolIcon Symbol="Search24" FontSize="20" />
          </ui:Button>
          <Separator Margin="8,10" />
          <ui:Button Appearance="Transparent" Margin="6,4" Padding="8" ToolTip="{x:Static res:SharedStrings.S321}" Click="OnImmersiveExit">
            <ui:SymbolIcon Symbol="FullScreenMinimize24" FontSize="20" />
          </ui:Button>
        </StackPanel>
      </Border>
      <Border Name="ImmersiveHint" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="16,7" Background="#D0202020" CornerRadius="16" IsHitTestVisible="False" Visibility="Collapsed">
        <TextBlock Text="{x:Static res:SharedStrings.S322}" Foreground="#FFFFFFFF" FontSize="12" FontWeight="SemiBold" />
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="16,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" Visibility="{Binding BackgroundJobVisible, Converter={StaticResource BoolToVis}}">
          <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" Text="{Binding BackgroundJobTitle}" />
          <ProgressBar Width="140" Height="6" Minimum="0" Maximum="100" VerticalAlignment="Center" Value="{Binding BackgroundJobProgress}" />
          <TextBlock VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0" Opacity="0.7" Text="{Binding BackgroundJobProgress, StringFormat={}{0}%}" />
          <Button ToolTip="{x:Static res:SharedStrings.S24}" Margin="8,0,0,0" Padding="4,0" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding CancelBackgroundJobCommand}" Visibility="{Binding BackgroundJobCancellable, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" />
          </Button>
        </StackPanel>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="360" Text="{Binding StatusText}" />
        <ctl:CreditBar Grid.Column="2" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Text="{Binding DrivePath}" />
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>