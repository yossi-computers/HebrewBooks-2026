<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="HebrewBooks.UI.Views.MadafManagerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:conv="clr-namespace:HebrewBooks.UI.Converters" xmlns:vm="clr-namespace:HebrewBooks.UI.ViewModels" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" Title="MadafManagerPage" xmlns:views="clr-namespace:HebrewBooks.UI.Views" FlowDirection="{m:LangFlow}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:StringNotEmptyToVisibility x:Key="StringNotEmptyToVisibility" />
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:Card Grid.Row="0" Padding="10" Margin="0,0,0,10">
      <WrapPanel>
        <ui:Button Content="{x:Static res:SharedStrings.S302}" Margin="0,0,8,0" Appearance="Primary" ToolTip="{x:Static res:SharedStrings.S303}" Command="{Binding NewRootShelfCommand}" />
        <ui:Button Content="{x:Static res:SharedStrings.S304}" Margin="0,0,8,0" ToolTip="{x:Static res:SharedStrings.S305}" Command="{Binding NewSubShelfCommand}" />
        <ui:Button Content="{x:Static res:SharedStrings.S306}" Margin="0,0,8,0" ToolTip="{x:Static res:SharedStrings.S307}" Command="{Binding RenameNodeCommand}" />
        <ui:Button Content="{x:Static res:SharedStrings.S308}" Margin="0,0,8,0" ToolTip="{x:Static res:SharedStrings.S309}" Command="{Binding TogglePinCommand}" />
        <ui:Button Content="{x:Static res:SharedStrings.S310}" Margin="0,0,8,0" ToolTip="{x:Static res:SharedStrings.S311}" Command="{Binding MoveToRootCommand}" />
        <ui:Button Content="{x:Static res:SharedStrings.S312}" Appearance="Danger" ToolTip="{x:Static res:SharedStrings.S313}" Command="{Binding DeleteNodeCommand}" />
      </WrapPanel>
    </ui:Card>
    <ui:Card Grid.Row="1" Padding="10" Margin="0,0,0,10">
      <Grid>
        <ui:TextBox Name="AddBookBox" PlaceholderText="{x:Static res:SharedStrings.S314}" Text="{Binding BookSearchText, Mode=OneWay}" TextChanged="OnAddBookTextChanged" />
        <Popup Placement="Bottom" AllowsTransparency="True" StaysOpen="True" PlacementTarget="{Binding ElementName=AddBookBox}" IsOpen="{Binding IsKeyboardFocusWithin, ElementName=AddBookBox, Mode=OneWay}" Width="{Binding ActualWidth, ElementName=AddBookBox}">
          <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" MaxHeight="320">
            <ListBox Name="AddBookSuggestions" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemsSource="{Binding BookSuggestions}" PreviewMouseLeftButtonDown="OnAddBookSuggestionClick">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                  <Setter Property="Focusable" Value="False" />
                  <Setter Property="Padding" Value="8,4" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding BookName}" />
                    <TextBlock FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                      <Run Text="{Binding AuthorName}" /> <Run Text=" · " /> <Run Text="{Binding FileID}" /></TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </Border>
        </Popup>
      </Grid>
    </ui:Card>
    <ui:Card Grid.Row="2" Padding="6">
      <TreeView Name="ShelfTreeView" BorderThickness="0" Background="#00FFFFFF" AllowDrop="True" ItemsSource="{Binding Tree}" SelectedItemChanged="OnTreeSelectedItemChanged" PreviewMouseRightButtonDown="OnTreeRightButtonDown" PreviewMouseLeftButtonDown="OnTreeMouseLeftButtonDown" PreviewMouseMove="OnTreeMouseMove" DragOver="OnTreeDragOver" Drop="OnTreeDrop">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="TreeViewItem.IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="TreeViewItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
              <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{Binding Glyph}" />
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Display}" />
              <TextBlock Text=" 📌" VerticalAlignment="Center" FontSize="11" Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
          </HierarchicalDataTemplate>
        </ItemsControl.ItemTemplate>
      </TreeView>
    </ui:Card>
    <Border Grid.Row="3" Margin="0,8,0,0">
      <TextBlock Opacity="0.8" Text="{Binding StatusText}" Visibility="{Binding StatusText, Converter={StaticResource StringNotEmptyToVisibility}}" />
    </Border>
  </Grid>
</Page>