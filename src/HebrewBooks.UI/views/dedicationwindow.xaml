<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="HebrewBooks.UI.Views.DedicationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Title="{x:Static res:SharedStrings.DedicationTitle}" Icon="/Resources/HebrewBooks.ico" Width="520" Height="640" MinWidth="460" MinHeight="560" WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" xmlns:views="clr-namespace:HebrewBooks.UI.Views" FlowDirection="{m:LangFlow}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="{x:Static res:SharedStrings.DedicationTitle}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="/Resources/HebrewBooks.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,8,24,8">
      <StackPanel>
        <TextBlock Text="{x:Static res:SharedStrings.DedicationIntro}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Border Name="TermsBox" Margin="0,12,0,0" Padding="12,8" CornerRadius="4" Background="{DynamicResource ControlFillColorTertiaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Visibility="Collapsed">
          <TextBlock Name="TermsText" TextWrapping="Wrap" FontSize="12" LineHeight="18" />
        </Border>
        <TextBlock Text="{x:Static res:SharedStrings.DonateRecipientNote}" TextWrapping="Wrap" FontSize="11" LineHeight="17" Margin="0,12,0,0" Opacity="0.8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{x:Static res:SharedStrings.DedicationKind}" FontWeight="SemiBold" FontSize="12" Margin="0,18,0,4" />
        <ComboBox Name="KindBox" SelectedIndex="0" Padding="10,6" />
        <TextBlock Text="{x:Static res:SharedStrings.DedicationText}" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,4" />
        <ui:TextBox Name="WordingInput" PlaceholderText="{x:Static res:SharedStrings.DedicationTextPlaceholder}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="300" MinHeight="70" Padding="10" TextChanged="OnTextChanged" />
        <TextBlock Text="{x:Static res:SharedStrings.DedicationDonor}" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,4" />
        <ui:TextBox Name="DonorInput" MaxLength="120" Padding="10" />
        <TextBlock Text="{x:Static res:SharedStrings.DedicationDonorHint}" FontSize="11" Opacity="0.75" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{x:Static res:SharedStrings.DedicationEmail}" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,4" />
        <ui:TextBox Name="EmailInput" MaxLength="200" Padding="10" FlowDirection="LeftToRight" />
        <TextBlock Text="{x:Static res:SharedStrings.DedicationEmailHint}" FontSize="11" Opacity="0.75" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Border Margin="0,18,0,0" Padding="12,8" CornerRadius="4" Background="{DynamicResource ControlFillColorTertiaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Top" Opacity="0.8" />
            <TextBlock Text="{x:Static res:SharedStrings.DedicationReviewNotice}" TextWrapping="Wrap" FontSize="12" LineHeight="18" MaxWidth="380" />
          </StackPanel>
        </Border>
        <TextBlock Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource ControlFillColorTertiaryBrush}" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <ui:Button Name="CancelButton" Content="{x:Static res:SharedStrings.ButtonCancel}" MinWidth="96" Margin="0,0,8,0" Click="OnCancel" />
        <ui:Button Name="SendButton" Content="{x:Static res:SharedStrings.DedicationSend}" Appearance="Primary" MinWidth="140" IsEnabled="False" Click="OnSend" />
        <ui:ProgressRing Name="Busy" IsIndeterminate="True" Width="22" Height="22" Margin="10,0,0,0" Visibility="Collapsed" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>