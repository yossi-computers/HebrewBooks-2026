<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="HebrewBooks.UI.Views.RepairBookOcrWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:HebrewBooks.UI.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="{x:Static res:SharedStrings.S84}" Height="540" Width="780" MinHeight="480" MinWidth="640" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="True" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" xmlns:views="clr-namespace:HebrewBooks.UI.Views" FlowDirection="{m:LangFlow}" Closing="OnClosing">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="16,40,16,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding BookName}" />
      <TextBlock FontSize="12" Opacity="0.6" Text="{Binding FileIdLabel}" />
    </StackPanel>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#1a000000" CornerRadius="6" Padding="6" Margin="0,0,16,0" VerticalAlignment="Top" MinHeight="200">
        <Image Stretch="Uniform" MaxHeight="220" Source="{Binding PreviewImage}" />
      </Border>
      <Grid Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" FontSize="14" FontWeight="SemiBold" Text="{Binding StageLabel}" />
          <TextBlock Grid.Column="1" FontSize="13" Opacity="0.75" Text="{Binding PageCounterText}" />
        </Grid>
        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Height="8" Margin="0,0,0,4" Value="{Binding Percent}" />
        <Grid Row="2" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" FontSize="12" Opacity="0.7" Text="{Binding ElapsedDisplay}" />
          <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{Binding Percent, StringFormat={}{0:F1}%}" />
          <TextBlock Grid.Column="2" FontSize="12" Opacity="0.7" TextAlignment="Left" Text="{Binding RemainingDisplay}" />
        </Grid>
        <Border Grid.Row="3" Background="#0a000000" CornerRadius="4" Padding="6">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding LogLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock FontSize="11" FontFamily="Consolas, Menlo, monospace" Opacity="0.8" TextWrapping="NoWrap" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="6" Background="#1a008000" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Text="{x:Static res:SharedStrings.S360}" FontWeight="SemiBold" FontSize="14" />
        <TextBlock Margin="0,4,0,0" Opacity="0.85" TextWrapping="Wrap" Text="{Binding SummaryText}" />
        <TextBlock FontSize="11" Margin="0,6,0,0" Opacity="0.65" TextWrapping="Wrap">
          <Run Text="{x:Static res:SharedStrings.S361}" />
          <LineBreak />
          <Run Text="{Binding SidecarPathDisplay}" />
        </TextBlock>
        <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.9" TextWrapping="Wrap" Text="{Binding UploadStatus}" />
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="6" Background="#1a800000" Visibility="{Binding IsErrorOrCancelled, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Text="{x:Static res:SharedStrings.S362}" FontWeight="SemiBold" FontSize="14" />
        <TextBlock Margin="0,4,0,0" Opacity="0.85" TextWrapping="Wrap" Text="{Binding SummaryText}" />
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <ui:Button Content="{x:Static res:SharedStrings.S363}" Appearance="Primary" MinWidth="120" Margin="0,0,8,0" Command="{Binding StartCommand}" Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" />
      <ui:Button Content="{x:Static res:SharedStrings.S359}" Appearance="Caution" MinWidth="120" Margin="0,0,8,0" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
      <ui:Button Content="{x:Static res:SharedStrings.S327}" MinWidth="120" Margin="0,0,8,0" Command="{Binding OpenFolderCommand}" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
      <ui:Button Name="CloseBtn" Content="{x:Static res:SharedStrings.S17}" MinWidth="80" Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>