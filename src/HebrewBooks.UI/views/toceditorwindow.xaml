<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="HebrewBooks.UI.Views.TocEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Title="{x:Static res:SharedStrings.S493}" Icon="/Resources/HebrewBooks.ico" Width="640" Height="640" WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" xmlns:views="clr-namespace:HebrewBooks.UI.Views" FlowDirection="{m:LangFlow}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="{x:Static res:SharedStrings.S493}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="/Resources/HebrewBooks.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
    <StackPanel Grid.Row="1" Margin="20,8,20,4">
      <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding BookTitle}" />
      <TextBlock Opacity="0.7" FontSize="12" Margin="0,4,0,0" Text="{Binding StatusText}" />
    </StackPanel>
    <Grid Row="2" Margin="20,8,20,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:DataGrid Name="EntriesGrid" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32" FontSize="13" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" FlowDirection="{m:LangFlow}" PreviewKeyDown="OnGridKeyDown">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{x:Static res:SharedStrings.S494}" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="{Binding IndentWidth}" />
                  <TextBlock Opacity="0.4" Margin="0,0,6,0" VerticalAlignment="Center" Text="{Binding DepthGuide}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="{Binding IndentWidth}" />
                  <TextBox MinWidth="220" BorderThickness="0" Background="#00FFFFFF" VerticalAlignment="Center" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{x:Static res:SharedStrings.S495}" Width="80" Binding="{Binding Page, UpdateSourceTrigger=PropertyChanged}" />
        </DataGrid.Columns>
      </ui:DataGrid>
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <ui:Button Content="{x:Static res:SharedStrings.S496}" MinWidth="90" Margin="0,0,0,6" Command="{Binding AddRowCommand}" />
        <ui:Button Content="{x:Static res:SharedStrings.S16}" MinWidth="90" Margin="0,0,0,16" Command="{Binding RemoveRowCommand}" />
        <ui:Button Content="{x:Static res:SharedStrings.S497}" MinWidth="90" Margin="0,0,0,6" Command="{Binding MoveUpCommand}" />
        <ui:Button Content="{x:Static res:SharedStrings.S498}" MinWidth="90" Margin="0,0,0,16" Command="{Binding MoveDownCommand}" />
        <ui:Button Content="{x:Static res:SharedStrings.S499}" MinWidth="90" Margin="0,0,0,6" ToolTip="{x:Static res:SharedStrings.S500}" Command="{Binding IndentCommand}" />
        <ui:Button Content="{x:Static res:SharedStrings.S501}" MinWidth="90" ToolTip="{x:Static res:SharedStrings.S502}" Command="{Binding OutdentCommand}" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource ControlFillColorTertiaryBrush}" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <ui:Button Content="{x:Static res:SharedStrings.S359}" MinWidth="100" Margin="0,0,8,0" Click="OnCancel" />
        <ui:Button Content="{x:Static res:SharedStrings.S503}" Appearance="Primary" MinWidth="100" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>