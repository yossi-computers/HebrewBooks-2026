                <ui:Button Name="RegionCopyTextBtn" MinWidth="32" Margin="0,0,4,4" Padding="4,2" ToolTip="{x:Static res:SharedStrings.S293}">
                  <ui:SymbolIcon Symbol="TextAlignJustify24" />
                </ui:Button>
              </WrapPanel>
              <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="{m:LangFlow}">
                <ui:Button MinWidth="40" Margin="0,0,4,4" ToolTip="{x:Static res:SharedStrings.S294}" Command="{Binding PrevBookCommand}">
                  <ui:SymbolIcon Symbol="ChevronDoubleRight20" />
                </ui:Button>
                <ui:Button MinWidth="40" Margin="0,0,6,4" ToolTip="{x:Static res:SharedStrings.S295}" Command="{Binding NextBookCommand}">
                  <ui:SymbolIcon Symbol="ChevronDoubleLeft20" />
                </ui:Button>
                <Border Width="1" Margin="6,3,8,4" Background="{DynamicResource ControlElevationBorderBrush}" />
                <ui:Button MinWidth="36" Margin="0,0,4,4" ToolTip="{x:Static res:SharedStrings.S296}" Command="{Binding PrevHitCommand}">
                  <ui:SymbolIcon Symbol="ChevronRight24" />
                </ui:Button>
                <ui:Button MinWidth="36" Margin="0,0,6,4" ToolTip="{x:Static res:SharedStrings.S297}" Command="{Binding NextHitCommand}">
                  <ui:SymbolIcon Symbol="ChevronLeft24" />
                </ui:Button>
                <ComboBox ItemContainerStyle="{StaticResource HitPageComboItem}" ToolTip="{x:Static res:SharedStrings.S298}" Padding="8,4" MinWidth="92" MaxDropDownHeight="320" Margin="0,0,8,4" ItemsSource="{Binding InBookHitPages}" SelectedItem="{Binding SelectedHitPage, Mode=TwoWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding StringFormat={x:Static res:SharedStrings.S9310}}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ComboBox>
                <TextBlock VerticalAlignment="Center" Opacity="0.85" FontSize="12" FontWeight="SemiBold" MinWidth="60" TextAlignment="Center" Margin="0,0,8,4" Text="{Binding MatchPositionText}" />
                <TextBlock VerticalAlignment="Center" Opacity="0.7" FontSize="12" Margin="8,0,0,4" Text="{Binding InBookSearchStatus}" />
              </WrapPanel>
            </Grid>
            <Grid Margin="0,6,0,0" Visibility="{Binding ShowHitPagesStrip, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold" Opacity="0.8" Text="{Binding InBookHitPages.Count, StringFormat={x:Static res:SharedStrings.S9312}}" />
              <ui:Button Grid.Column="1" Content="‹" Tag="-1" MinWidth="28" Padding="0" Margin="0,0,2,0" ToolTip="{x:Static res:SharedStrings.S299}" Click="OnHitStripScrollClick" />
              <ListBox Name="HitStripList" Grid.Column="2" Style="{StaticResource HitPagesStrip}" beh:ListBoxScrollIntoView.Enabled="True" ItemsSource="{Binding InBookHitPages}" SelectedItem="{Binding SelectedHitPage, Mode=TwoWay}" />
              <ui:Button Grid.Column="3" Content="›" Tag="1" MinWidth="28" Padding="0" Margin="2,0,0,0" ToolTip="{x:Static res:SharedStrings.S299}" Click="OnHitStripScrollClick" />
            </Grid>
          </StackPanel>
        </Border>
        <Grid Name="ViewerHostContainer" Row="2">
          <TextBlock Name="PdfPlaceholder" Text="{x:Static res:SharedStrings.S300}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Opacity="0.5" IsHitTestVisible="False" />
          <Border Name="TabDropZone" Visibility="Collapsed" Margin="20,60" CornerRadius="10" Background="#00FFFFFF" BorderThickness="2" BorderBrush="{DynamicResource ControlElevationBorderBrush}" VerticalAlignment="Bottom" MinHeight="72" AllowDrop="True" DragOver="OnViewerDragOver" Drop="OnViewerDrop" DragEnter="OnTabDropZoneToggle" DragLeave="OnTabDropZoneToggle">
            <TextBlock Name="TabDropZoneHint" Text="{x:Static res:SharedStrings.S301}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Opacity="0.6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>