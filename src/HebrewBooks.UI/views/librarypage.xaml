<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="HebrewBooks.UI.Views.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:HebrewBooks.UI.Controls" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:conv="clr-namespace:HebrewBooks.UI.Converters" xmlns:beh="clr-namespace:HebrewBooks.UI.Behaviors" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:vm="clr-namespace:HebrewBooks.UI.ViewModels" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Title="LibraryPage" xmlns:views="clr-namespace:HebrewBooks.UI.Views" FlowDirection="{m:LangFlow}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <conv:StringNotEmptyToVisibility x:Key="StringNotEmptyToVisibility" />
      <conv:SourceTypeLabelConverter x:Key="SourceTypeLabel" />
      <conv:SourceTypeIconConverter x:Key="SourceTypeIcon" />
      <conv:HebrewYearConverter x:Key="HebrewYear" />
      <conv:FileIdMarkedConverter x:Key="FileIdMarked" />
      <conv:GroupMarkedConverter x:Key="GroupMarked" />
      <conv:FileIdFavoritedConverter x:Key="FileIdFavorited" />
      <conv:ClampedScaleConverter x:Key="ClampedScale" />
      <DataTemplate x:Key="BookDetailsTip">
        <StackPanel MaxWidth="420">
          <TextBlock FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Text="{Binding BookName}" />
          <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Text="{Binding AuthorName}" Visibility="{Binding AuthorName, Converter={StaticResource StringNotEmptyToVisibility}}" />
          <Separator Margin="0,6" Opacity="0.4" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelPrintPlace}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,8,2" Visibility="{Binding PrintPlace, Converter={StaticResource StringNotEmptyToVisibility}}" />
            <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding PrintPlace}" Visibility="{Binding PrintPlace, Converter={StaticResource StringNotEmptyToVisibility}}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelPrintYear}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,8,2" Visibility="{Binding PrintYear, Converter={StaticResource StringNotEmptyToVisibility}}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,2" Text="{Binding PrintYear, Converter={StaticResource HebrewYear}}" Visibility="{Binding PrintYear, Converter={StaticResource StringNotEmptyToVisibility}}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelPages}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,8,2" />
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,2" Text="{Binding CountPage}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelFileId}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,8,2" />
            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,2" Text="{Binding FileID}" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static res:SharedStrings.LabelDescription}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,8,0" VerticalAlignment="Top" Visibility="{Binding Description, Converter={StaticResource StringNotEmptyToVisibility}}" />
            <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Description}" Visibility="{Binding Description, Converter={StaticResource StringNotEmptyToVisibility}}" />
          </Grid>
        </StackPanel>
      </DataTemplate>
      <ctl:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="OuterGrid" Margin="16,8,16,12" AllowDrop="True" DragOver="OnPageDragOver" Drop="OnPageDrop">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Name="CatalogCol" Width="*" MinWidth="320" />
      <ColumnDefinition Name="LibSplitterCol" Width="6" />
      <ColumnDefinition Name="PdfCol" Width="*" MinWidth="320" />
    </Grid.ColumnDefinitions>
    <ui:Card Name="TopSearchCard" Grid.Row="0" Grid.ColumnSpan="3" Padding="12,6" Margin="0,0,0,6">
      <StackPanel>
        <Grid>
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Style.Triggers>
                  <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Column="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" MinWidth="36" Padding="8,6" Margin="0,0,4,0" ToolTip="{x:Static res:SharedStrings.S243}" ToolTipService.ShowOnDisabled="True" Command="{Binding GoBackCommand}">
              <ui:SymbolIcon Symbol="ChevronRight24" />
            </ui:Button>
            <ui:Button Grid.Column="1" MinWidth="36" Padding="8,6" Margin="0,0,8,0" ToolTip="{x:Static res:SharedStrings.S244}" ToolTipService.ShowOnDisabled="True" Command="{Binding GoForwardCommand}">
              <ui:SymbolIcon Symbol="ChevronLeft24" />
            </ui:Button>
            <Border Grid.Column="2" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Name="CatalogFilterBox" Grid.Column="0" beh:SelectAllOnFocus.Enabled="True" FontSize="14" Padding="8,6" BorderThickness="0" Background="#00FFFFFF" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" PlaceholderText="{Binding SearchBoxPlaceholder}">
                  <UIElement.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding RunContentSearchCommand}" />
                  </UIElement.InputBindings>
                </ui:TextBox>
                <ui:Button Grid.Column="1" Appearance="Transparent" BorderThickness="0" Padding="8,4" Margin="0,1,1,1" ToolTip="{x:Static res:SharedStrings.S245}" Command="{Binding RunContentSearchCommand}" Visibility="{Binding ContentSearchEnabled, Converter={StaticResource BoolToVis}}">
                  <ui:SymbolIcon Symbol="Search24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </ui:Button>
              </Grid>
            </Border>
          </Grid>
          <ui:Button Grid.Column="1" Appearance="Caution" MinWidth="80" Padding="10,6" Margin="8,0,0,0" ToolTip="{x:Static res:SharedStrings.S246}" Content="{Binding StopButtonText}" Command="{Binding CancelContentSearchCommand}" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
          <ui:Button Grid.Column="2" MinWidth="36" Padding="8,5" Margin="6,0,0,0" ToolTip="{x:Static res:SharedStrings.S247}" Command="{Binding ExitContentModeCommand}" Visibility="{Binding IsContentMode, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="Dismiss24" />
          </ui:Button>
          <ui:Button Grid.Column="6" Appearance="Transparent" Margin="20,0,0,0" Padding="6,5" ToolTip="{x:Static res:SharedStrings.S248}" Visibility="{Binding ContentSearchEnabled, Converter={StaticResource BoolToVis}}" Click="OnNewWindowClick">
            <ui:SymbolIcon Symbol="WindowNew24" />
          </ui:Button>
        </Grid>
        <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="4,5,4,0" Text="{Binding SearchHint}" Visibility="{Binding HasSearchHint, Converter={StaticResource BoolToVis}}" />
        <StackPanel Margin="4,8,4,0">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="True" Binding="{Binding ShowChipSelector}" />
                    <Condition Value="True" Binding="{Binding IsKeyboardFocusWithin, ElementName=TopSearchCard}" />
                    <Condition Value="False" Binding="{Binding ChipsScrollDismissed}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <TextBlock Text="{x:Static res:SharedStrings.S249}" Opacity="0.6" FontSize="12" Margin="0,0,0,5" />
          <ItemsControl ItemsSource="{Binding SynonymGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Opacity="0.7" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,6,8,0" Text="{Binding Source, StringFormat={}{0}:}" />
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Chips}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ToggleButton Margin="0,0,8,8" Padding="12,5" Cursor="Hand" FontSize="13" Content="{Binding Term}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                              <Border Name="ChipBorder" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Control.Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="ChipBorder" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" Property="Border.BorderBrush" />
                                </Trigger>
                                <Trigger Property="ToggleButton.IsChecked" Value="True">
                                  <Setter TargetName="ChipBorder" Value="{DynamicResource AccentControlElevationFillColorRestBrush}" Property="Border.Background" />
                                  <Setter TargetName="ChipBorder" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" Property="Border.BorderBrush" />
                                  <Setter TargetName="ChipBorder" Property="Border.BorderThickness" Value="2" />
                                  <Setter Property="Control.FontWeight" Value="SemiBold" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasSelectedChips, Converter={StaticResource BoolToVis}}">
            <ui:Button Appearance="Primary" Margin="0,2,0,0" Padding="12,5" FontSize="13" Content="{Binding SearchWithSelectedLabel}" Command="{Binding SearchWithSelectedChipsCommand}" />
            <TextBlock Text="{x:Static res:SharedStrings.S250}" Opacity="0.55" FontSize="11" VerticalAlignment="Center" Margin="10,2,0,0" />
          </StackPanel>
        </StackPanel>
        <Border Margin="4,8,4,0" Padding="10,5" CornerRadius="12" HorizontalAlignment="Right" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Visibility="{Binding HasActiveChips, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{x:Static res:SharedStrings.S251}" Opacity="0.7" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ActiveChipsSummary}" />
          </StackPanel>
        </Border>
        <Border Margin="4,8,4,0" Padding="10,5" CornerRadius="12" HorizontalAlignment="Right" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Visibility="{Binding HasSpellCorrection, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{x:Static res:SharedStrings.S252}" Opacity="0.7" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SpellCorrectedTo}" />
            <TextBlock Text="·" Opacity="0.5" FontSize="12" VerticalAlignment="Center" Margin="8,0" />
            <TextBlock FontSize="12" VerticalAlignment="Center">
              <Hyperlink TextDecorations="Underline" Command="{Binding SearchTypedExactCommand}">
                <Run Text="{x:Static res:SharedStrings.S9048}" /> <Run FontWeight="SemiBold" Text="{Binding SpellCorrectedFrom, Mode=OneWay}" /></Hyperlink>
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </ui:Card>
    <ui:Card Name="FilterCard" Grid.Row="1" Grid.Column="0" Padding="12,6" Margin="0,0,0,6">
      <StackPanel>
        <FrameworkElement.LayoutTransform>
          <ScaleTransform ScaleX="{Binding ActualWidth, ElementName=FilterCard, Converter={StaticResource ClampedScale}, ConverterParameter=660}" ScaleY="{Binding ActualWidth, ElementName=FilterCard, Converter={StaticResource ClampedScale}, ConverterParameter=660}" />
        </FrameworkElement.LayoutTransform>
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="{x:Static res:SharedStrings.S254}" FontWeight="SemiBold" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Grid Margin="0,0,8,0" Visibility="{Binding HasMultipleSources, Converter={StaticResource BoolToVis}}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}">
                  <Style.Triggers>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter Property="Background" Value="#00FFFFFF" />
                      <Setter Property="BorderBrush" Value="#00FFFFFF" />
                      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <ToggleButton Name="CorpusFilterToggle" MinWidth="110" MaxWidth="200" Padding="7,5" Background="#00FFFFFF" BorderThickness="0" HorizontalContentAlignment="Stretch" ToolTip="{x:Static res:SharedStrings.S255}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding CorpusFilterSummary}" />
                <TextBlock Grid.Column="1" Text="▾" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6" />
              </Grid>
            </ToggleButton>
            <Popup Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" beh:PopupReopenGuard.Enabled="True" IsOpen="{Binding IsChecked, ElementName=CorpusFilterToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=CorpusFilterToggle}" Opened="OnCorpusFilterPopupOpened">
              <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" MinWidth="180">
                <ItemsControl ItemsSource="{Binding CorpusFilters}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Margin="2,4" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </Popup>
          </Grid>
          <ui:Button Name="ShelfMenuButton" Content="{x:Static res:SharedStrings.S256}" ToolTip="{x:Static res:SharedStrings.S257}" MinWidth="90" Padding="7,5" Margin="0,0,8,0" Background="#00FFFFFF" BorderThickness="0" BorderBrush="#00FFFFFF" Visibility="{m:HideInProtectMode}" Click="OnShelfMenuClick" />
          <ctl:TopicFilterControl Margin="0,0,8,0" DataContext="{Binding Topics}" />
          <ctl:YearFilterControl Margin="0,0,8,0" DataContext="{Binding Years}" />
          <ComboBox DisplayMemberPath="Label" ToolTip="{x:Static res:SharedStrings.S258}" MinWidth="110" Padding="7,5" Margin="0,0,8,0" Background="#00FFFFFF" BorderThickness="0" ItemsSource="{Binding ContentScopeOptions}" SelectedItem="{Binding SelectedScopeOption, Mode=TwoWay}" Visibility="{Binding ContentSearchEnabled, Converter={StaticResource BoolToVis}}" />
        </WrapPanel>
        <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
          <ctl:SortFilterControl Margin="0,0,8,0" DataContext="{Binding Sorting}" />
          <Border Width="1" Height="26" VerticalAlignment="Center" Margin="4,0,14,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
          <ToggleButton Name="AdvancedToggle" Padding="7,5" Margin="0,0,4,0" VerticalAlignment="Center" Background="#00FFFFFF" BorderThickness="0" ToolTip="{x:Static res:SharedStrings.S259}" Visibility="{Binding ContentSearchEnabled, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static res:SharedStrings.S260}" VerticalAlignment="Center" />
              <TextBlock Text="▾" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6" />
            </StackPanel>
          </ToggleButton>
          <Popup Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" beh:PopupReopenGuard.Enabled="True" IsOpen="{Binding IsChecked, ElementName=AdvancedToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AdvancedToggle}">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" MinWidth="320" FlowDirection="{m:LangFlow}">
              <StackPanel>
                <TextBlock Text="{x:Static res:SharedStrings.S261}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <CheckBox Content="{x:Static res:SharedStrings.OptionHybur}" Margin="0,2" IsChecked="{Binding Hybur}" />
                <CheckBox Content="{x:Static res:SharedStrings.OptionRootSearch}" Margin="0,2" IsChecked="{Binding RootSearch}" />
                <CheckBox Content="{x:Static res:SharedStrings.OptionRasheyTevot}" Margin="0,2" IsChecked="{Binding RasheyTevot}" />
                <CheckBox Content="{x:Static res:SharedStrings.S133}" Margin="0,2" IsChecked="{Binding ExpandNumberGender}" />
                <CheckBox Content="{x:Static res:SharedStrings.S262}" Margin="0,2" IsChecked="{Binding ExpandGematria}" />
                <CheckBox Content="{x:Static res:SharedStrings.S135}" Margin="0,2" IsChecked="{Binding ExpandSpelling}" />
                <CheckBox Content="{x:Static res:SharedStrings.S136}" Margin="0,2" IsChecked="{Binding ExpandAramaic}" />
                <CheckBox Content="{x:Static res:SharedStrings.S263}" Margin="0,2" ToolTip="{x:Static res:SharedStrings.S264}" IsChecked="{Binding ExpandRashiOcr}" />
                <CheckBox Content="{x:Static res:SharedStrings.S265}" Margin="0,2" ToolTip="{x:Static res:SharedStrings.S266}" IsChecked="{Binding ExpandWeakLetters}" />
                <Separator Margin="0,10,0,8" Opacity="0.5" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="{x:Static res:SharedStrings.OptionProximity}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ui:NumberBox Minimum="0" Maximum="999" MinWidth="100" Margin="0,0,16,0" FlowDirection="LeftToRight" Value="{Binding MaxProximity}" />
                  <TextBlock Text="{x:Static res:SharedStrings.S267}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{x:Static res:SharedStrings.S268}" />
                  <ui:NumberBox Minimum="0" Maximum="10" MinWidth="84" FlowDirection="LeftToRight" Value="{Binding Fuzziness}" />
                </StackPanel>
                <CheckBox Content="{x:Static res:SharedStrings.S138}" ToolTip="{x:Static res:SharedStrings.S269}" Margin="0,0,0,8" IsChecked="{Binding RequireWordOrder}" />
                <StackPanel Orientation="Horizontal">
                  <ui:Button Content="{x:Static res:SharedStrings.S270}" ToolTip="{x:Static res:SharedStrings.S271}" Margin="0,0,8,0" Padding="10,4" FontSize="12" Command="{Binding ToggleFirstWordCommand}" />
                  <ui:Button Content="{x:Static res:SharedStrings.S272}" ToolTip="{x:Static res:SharedStrings.S273}" Padding="10,4" FontSize="12" Command="{Binding ToggleLastWordCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Popup>
          <ToggleButton Name="HistoryToggle" Padding="7,5" Margin="0,0,4,0" VerticalAlignment="Center" Background="#00FFFFFF" BorderThickness="0" ToolTip="{x:Static res:SharedStrings.S274}" Visibility="{Binding ContentSearchEnabled, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static res:SharedStrings.S275}" VerticalAlignment="Center" />
              <TextBlock Text="▾" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6" />
            </StackPanel>
          </ToggleButton>
          <Popup Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" beh:PopupReopenGuard.Enabled="True" IsOpen="{Binding IsChecked, ElementName=HistoryToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=HistoryToggle}">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6" MinWidth="280" MaxWidth="480" FlowDirection="{m:LangFlow}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static res:SharedStrings.S274}" FontWeight="SemiBold" Margin="6,4,6,6" />
                <ui:Button DockPanel.Dock="Bottom" Content="{x:Static res:SharedStrings.S276}" HorizontalAlignment="Stretch" Margin="0,6,0,0" Command="{Binding ClearHistoryCommand}" />
                <ItemsControl MaxHeight="320" ItemsSource="{Binding SearchHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button HorizontalContentAlignment="Right" BorderThickness="0" Background="#00FFFFFF" Padding="6,4" Cursor="Hand" Content="{Binding}" Click="OnHistoryEntryClick" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </Border>
          </Popup>
          <Border Width="1" Height="26" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="12,0,14,0" Visibility="{Binding HasMarkedBooks, Converter={StaticResource BoolToVis}}" />
          <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" Text="{Binding MarkedCount, StringFormat={x:Static res:SharedStrings.S9313}}" Visibility="{Binding HasMarkedBooks, Converter={StaticResource BoolToVis}}" />
          <ui:Button Appearance="Transparent" Padding="6,5" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="{x:Static res:SharedStrings.S277}" Command="{Binding MarkAllDisplayedCommand}" Visibility="{Binding HasMarkedBooks, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="SelectAllOn24" />
          </ui:Button>
          <ui:Button Appearance="Transparent" Padding="6,5" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="{x:Static res:SharedStrings.S278}" Command="{Binding ClearMarksCommand}" Visibility="{Binding HasMarkedBooks, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="Dismiss24" />
          </ui:Button>
        </WrapPanel>
      </StackPanel>
    </ui:Card>
    <Grid Name="CatalogPanel" Row="2" Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
        <Border Width="1" Background="{DynamicResource ControlElevationBorderBrush}" Margin="8,2" Visibility="{Binding IsContentMode, Converter={StaticResource BoolToVis}}" />
        <ui:TextBox PlaceholderText="{x:Static res:SharedStrings.S279}" beh:SelectAllOnFocus.Enabled="True" MinWidth="180" Padding="8,4" Margin="0,0,0,4" Text="{Binding ResultFilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Visibility="{Binding IsContentMode, Converter={StaticResource BoolToVis}}" />
        <Border Padding="10,3" CornerRadius="12" Margin="0,0,0,4" Background="{DynamicResource ControlFillColorTertiaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" VerticalAlignment="Center" Visibility="{Binding IsScopeActive, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.85" Text="{Binding ScopeChipText}" />
            <Button Content="✕" Margin="8,0,0,0" Padding="3,0" BorderThickness="0" Background="#00FFFFFF" ToolTip="{x:Static res:SharedStrings.S280}" Cursor="Hand" Command="{Binding ClearScopeCommand}" />
          </StackPanel>
        </Border>
      </WrapPanel>
