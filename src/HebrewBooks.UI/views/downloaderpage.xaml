<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="HebrewBooks.UI.Views.DownloaderPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:HebrewBooks.UI.ViewModels" xmlns:conv="clr-namespace:HebrewBooks.UI.Converters" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" Title="DownloaderPage" xmlns:views="clr-namespace:HebrewBooks.UI.Views" FlowDirection="{m:LangFlow}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <conv:InverseBooleanToVisibility x:Key="NotBoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <ScrollViewer Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="16" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="2*" MinHeight="280" />
          <RowDefinition Height="6" />
          <RowDefinition Height="Auto" MinHeight="220" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{x:Static res:SharedStrings.S18}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
          <ui:Card Grid.Row="1" Padding="14" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Static res:SharedStrings.S19}" Opacity="0.6" FontSize="12" />
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding MaxLocal}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Static res:SharedStrings.S20}" Opacity="0.6" FontSize="12" />
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding MaxOnSite}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{x:Static res:SharedStrings.S21}" Opacity="0.6" FontSize="12" />
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding PendingCount}" />
              </StackPanel>
              <ui:Button Grid.Column="3" Content="{x:Static res:SharedStrings.S22}" Padding="14,6" VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
            </Grid>
          </ui:Card>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Content="{x:Static res:SharedStrings.S23}" Appearance="Primary" Padding="18,6" Margin="0,0,8,0" Command="{Binding StartCommand}" Visibility="{Binding IsRunning, Converter={StaticResource NotBoolToVis}}" />
            <ui:Button Content="{x:Static res:SharedStrings.S24}" Appearance="Caution" Padding="18,6" Margin="0,0,8,0" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            <ui:Button Content="{x:Static res:SharedStrings.S25}" Padding="14,6" Margin="0,0,8,0" ToolTip="{x:Static res:SharedStrings.S26}" Command="{Binding LoadCandidatesCommand}" Visibility="{Binding IsRunning, Converter={StaticResource NotBoolToVis}}" />
            <ui:Button Content="{x:Static res:SharedStrings.S27}" Padding="14,6" Margin="0,0,8,0" ToolTip="{x:Static res:SharedStrings.S28}" Command="{Binding ScanAndCompleteCommand}" Visibility="{Binding IsRunning, Converter={StaticResource NotBoolToVis}}" />
            <ui:Button Content="{x:Static res:SharedStrings.S29}" Padding="14,6" Margin="0,0,8,0" ToolTip="{x:Static res:SharedStrings.S30}" Command="{Binding RebuildIndexCommand}" />
            <Border VerticalAlignment="Center" Margin="16,0,0,0" Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="6" Padding="10,4" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
              <TextBlock FontSize="12">
                <Run Text="{Binding Processed, FallbackValue=0, Mode=OneWay}" /> <Run Text="{x:Static res:SharedStrings.S9004}" /> <Run Text="{Binding Succeeded, FallbackValue=0, Mode=OneWay}" /> <Run Text="{x:Static res:SharedStrings.S9005}" /> <Run Text="{Binding Failed, FallbackValue=0, Mode=OneWay}" /> <Run Text="{x:Static res:SharedStrings.S2095}" /></TextBlock>
            </Border>
          </StackPanel>
          <Grid Row="3">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="80" />
            </Grid.RowDefinitions>
            <ui:Card Grid.Row="0" Padding="0" Margin="0,0,0,10" MaxHeight="320" Visibility="{Binding ShowCandidates, Converter={StaticResource BoolToVis}}">
              <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource ControlFillColorTertiaryBrush}" Padding="10,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold">
                      <Run Text="{x:Static res:SharedStrings.S9006}" /> <Run FontWeight="Bold" Text="{Binding SelectedCount, Mode=OneWay}" /></TextBlock>
                    <ui:TextBox Grid.Column="1" Margin="10,0,10,0" MinWidth="120" PlaceholderText="{x:Static res:SharedStrings.S35}" Text="{Binding CandidateFilter, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                      <ui:Button Content="{x:Static res:SharedStrings.S36}" Padding="10,4" Margin="0,0,6,0" Command="{Binding SelectAllCandidatesCommand}" />
                      <ui:Button Content="{x:Static res:SharedStrings.S37}" Padding="10,4" Command="{Binding SelectNoCandidatesCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="10,8" Background="{DynamicResource ControlFillColorTertiaryBrush}">
                  <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{x:Static res:SharedStrings.S38}" Appearance="Primary" Padding="16,6" Margin="0,0,8,0" Command="{Binding DownloadSelectedCommand}" Visibility="{Binding IsRunning, Converter={StaticResource NotBoolToVis}}" />
                    <ui:Button Content="{x:Static res:SharedStrings.S24}" Appearance="Caution" Padding="16,6" Margin="0,0,8,0" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
                  </StackPanel>
                </Border>
                <ListBox BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Candidates}">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Focusable" Value="False" />
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Style.Triggers>
                        <DataTrigger Value="False" Binding="{Binding IsVisible}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Margin="6,3" Padding="6,0" IsChecked="{Binding IsSelected}">
                        <TextBlock TextTrimming="CharacterEllipsis">
                          <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding FileId, Mode=OneWay}" /> <Run Text="  " /> <Run Text="{Binding Display, Mode=OneWay}" /></TextBlock>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ListBox>
              </DockPanel>
            </ui:Card>
            <ui:Card Grid.Row="1" Padding="0">
              <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource ControlFillColorTertiaryBrush}" Padding="10,6">
                  <TextBlock Text="{x:Static res:SharedStrings.S39}" FontWeight="SemiBold" />
                </Border>
                <ListBox Name="LogList" BorderThickness="0" FontFamily="Consolas, Cascadia Code, monospace" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="False" ItemsSource="{Binding Logs}">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                      <Setter Property="Padding" Value="8,2" />
                      <Setter Property="Focusable" Value="False" />
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </ListBox>
              </DockPanel>
            </ui:Card>
          </Grid>
          <Border Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Opacity="0.85" Text="{Binding StatusText}" />
          </Border>
        </Grid>
        <Border Grid.Row="1" Margin="0,12,0,12" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0" />
        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#00FFFFFF" ResizeBehavior="PreviousAndNext" />
        <Grid Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{x:Static res:SharedStrings.S40}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
          <ui:Card Grid.Row="1" Padding="16">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" Text="{x:Static res:SharedStrings.S41}" />
              <ProgressBar Height="6" Margin="0,0,0,8" Value="{Binding OtzrayaSyncProgressDone}" Maximum="{Binding OtzrayaSyncProgressTotal}" Visibility="{Binding OtzrayaSyncing, Converter={StaticResource BoolToVis}}" />
              <TextBlock FontFamily="Consolas, Cascadia Code, monospace" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" Text="{Binding OtzrayaSyncCurrentFile}" Visibility="{Binding OtzrayaSyncing, Converter={StaticResource BoolToVis}}" />
              <TextBlock Margin="0,8,0,8" Opacity="0.85" TextWrapping="Wrap" Text="{Binding OtzrayaSyncStatus}" />
              <StackPanel Orientation="Horizontal">
                <ui:Button Content="{x:Static res:SharedStrings.S42}" Appearance="Primary" Padding="18,6" MinWidth="160" Margin="0,0,8,0" Command="{Binding SyncOtzrayaCommand}" Visibility="{Binding OtzrayaSyncing, Converter={StaticResource NotBoolToVis}}" />
                <ui:Button Content="{x:Static res:SharedStrings.S43}" Appearance="Caution" Padding="18,6" MinWidth="120" Command="{Binding CancelOtzrayaSyncCommand}" Visibility="{Binding OtzrayaSyncing, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
              <Border Margin="0,16,0,12" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0" />
              <TextBlock Text="{x:Static res:SharedStrings.S44}" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" Text="{x:Static res:SharedStrings.S45}" />
              <ProgressBar Height="6" Margin="0,0,0,8" Value="{Binding OtzrayaScanProgressDone}" Maximum="{Binding OtzrayaScanProgressTotal}" Visibility="{Binding OtzrayaScanning, Converter={StaticResource BoolToVis}}" />
              <StackPanel Orientation="Horizontal">
                <ui:Button Content="{x:Static res:SharedStrings.S46}" Padding="14,6" MinWidth="140" Margin="0,0,8,0" Command="{Binding ScanOtzrayaCatalogCommand}" Visibility="{Binding OtzrayaScanning, Converter={StaticResource NotBoolToVis}}" />
                <ui:Button Content="{x:Static res:SharedStrings.S47}" Padding="14,6" MinWidth="120" Margin="0,0,8,0" Appearance="Caution" Command="{Binding CancelOtzrayaScanCommand}" Visibility="{Binding OtzrayaScanning, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="{x:Static res:SharedStrings.S29}" Padding="14,6" MinWidth="140" ToolTip="{x:Static res:SharedStrings.S48}" Command="{Binding BuildOtzrayaIndexCommand}" />
              </StackPanel>
            </StackPanel>
          </ui:Card>
        </Grid>
        <Grid Row="3">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{x:Static res:SharedStrings.S49}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,12" />
          <ui:Card Grid.Row="1" Padding="16">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" Text="{x:Static res:SharedStrings.S50}" />
              <ProgressBar Height="6" Margin="0,0,0,8" Value="{Binding PublishedProgressDone}" Maximum="{Binding PublishedProgressTotal}" Visibility="{Binding PublishedBusy, Converter={StaticResource BoolToVis}}" />
              <TextBlock Margin="0,4,0,8" Opacity="0.85" TextWrapping="Wrap" Text="{Binding PublishedStatus}" />
              <StackPanel Orientation="Horizontal">
                <ui:Button Content="{x:Static res:SharedStrings.S51}" Padding="18,6" MinWidth="140" Margin="0,0,8,0" Command="{Binding CheckPublishedCommand}" Visibility="{Binding PublishedBusy, Converter={StaticResource NotBoolToVis}}" />
                <ui:Button Content="{x:Static res:SharedStrings.S52}" Appearance="Primary" Padding="18,6" MinWidth="180" Margin="0,0,8,0" Command="{Binding SyncPublishedCommand}" Visibility="{Binding PublishedBusy, Converter={StaticResource NotBoolToVis}}" />
                <ui:Button Content="{x:Static res:SharedStrings.S24}" Appearance="Caution" Padding="18,6" MinWidth="100" Command="{Binding CancelPublishedSyncCommand}" Visibility="{Binding PublishedBusy, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
              <Separator Margin="0,14,0,10" />
              <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" Text="{x:Static res:SharedStrings.S53}" />
              <ui:Button Content="{x:Static res:SharedStrings.S54}" Appearance="Secondary" Padding="18,6" MinWidth="180" HorizontalAlignment="Right" Command="{Binding OpenUploadToServerCommand}" />
            </StackPanel>
          </ui:Card>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
          <TextBlock Text="{x:Static res:SharedStrings.S55}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
          <ui:Card Padding="16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock TextWrapping="Wrap" Opacity="0.8" Text="{x:Static res:SharedStrings.S56}" />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="{x:Static res:SharedStrings.S55}" Appearance="Primary" Padding="18,6" MinWidth="180" VerticalAlignment="Center" Command="{Binding OpenPersonalCorpusCommand}" />
            </Grid>
          </ui:Card>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Background="#99000000" Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVis}}">
      <ui:Card VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="780" Margin="24" Padding="0">
        <StackPanel>
          <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" Padding="14,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" FontSize="16" FontWeight="SemiBold">
                <Run Text="{x:Static res:SharedStrings.S9007}" /> <Run Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding IxStep, Mode=OneWay}" /></TextBlock>
              <TextBlock Grid.Column="1" FontSize="16" FontWeight="Bold">
                <Run Text="{Binding IxPercent, Mode=OneWay}" />
                <Run Text="%" />
              </TextBlock>
            </Grid>
          </Border>
          <ProgressBar Minimum="0" Maximum="100" Height="8" Margin="14,12,14,2" Value="{Binding IxPercent}" />
          <Grid Margin="14,8,14,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
              <StackPanel>
                <TextBlock Text="{x:Static res:SharedStrings.S58}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:SharedStrings.S59}" Opacity="0.6" Margin="0,1,10,1" />
                  <TextBlock Grid.Row="0" Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,1" Text="{Binding IxName}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:SharedStrings.S60}" Opacity="0.6" Margin="0,1,10,1" />
                  <TextBlock Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,1" Text="{Binding IxLocation}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:SharedStrings.S61}" Opacity="0.6" Margin="0,1,10,1" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,1" Text="{Binding IxWords}" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:SharedStrings.S62}" Opacity="0.6" Margin="0,1,10,1" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,1" Text="{Binding IxDocs}" />
                  <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static res:SharedStrings.S63}" Opacity="0.6" Margin="0,1,10,1" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,1">
                    <Run Text="{Binding IxToIndexFiles, Mode=OneWay}" />
                    <Run Text="  ·  " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Run Text="{Binding IxToIndexMb, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Grid.Row="6" Grid.Column="0" Text="{x:Static res:SharedStrings.S64}" Opacity="0.6" Margin="0,1,10,1" />
                  <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,1">
                    <Run Text="{Binding IxIndexedFiles, Mode=OneWay}" />
                    <Run Text="  ·  " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Run Text="{Binding IxIndexedMb, Mode=OneWay}" />
                  </TextBlock>
                </Grid>
              </StackPanel>
            </Border>
            <Border Grid.Row="0" Grid.Column="2" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
              <StackPanel>
                <TextBlock Text="{x:Static res:SharedStrings.S65}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:SharedStrings.S66}" Opacity="0.6" Margin="0,1,10,1" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,1" Text="{Binding IxElapsed}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:SharedStrings.S67}" Opacity="0.6" Margin="0,1,10,1" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,1" Text="{Binding IxRemaining}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:SharedStrings.S68}" Opacity="0.6" Margin="0,1,10,1" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,1" Text="{Binding IxDiskFree}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
              <StackPanel>
                <TextBlock Text="{x:Static res:SharedStrings.S69}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:SharedStrings.S59}" Opacity="0.6" Margin="0,1,10,1" />
                  <TextBlock Grid.Row="0" Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,1" Text="{Binding IxCurFileName}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:SharedStrings.S70}" Opacity="0.6" Margin="0,1,10,1" />
                  <TextBlock Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis" Opacity="0.85" Margin="0,1" Text="{Binding IxCurFileLocation}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:SharedStrings.S71}" Opacity="0.6" Margin="0,1,10,1" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,1">
                    <Run Text="{Binding IxCurFileType, Mode=OneWay}" />
                    <Run Text="   " />
                    <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding IxCurFileSize, Mode=OneWay}" />
                    <Run Text="  ·  " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding IxCurFileWords, Mode=OneWay}" />
                    <Run Text="{x:Static res:SharedStrings.S9008}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </TextBlock>
                  <ProgressBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Height="6" Margin="0,8,0,0" Value="{Binding IxCurFilePercent}" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
          <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" Padding="14,10" Visibility="{Binding IndexJobActive, Converter={StaticResource BoolToVis}}">
            <ui:Button Content="{x:Static res:SharedStrings.S24}" Appearance="Caution" HorizontalAlignment="Center" MinWidth="120" Padding="20,6" Command="{Binding CancelIndexCommand}" />
          </Border>
        </StackPanel>
      </ui:Card>
    </Border>
  </Grid>
</Page>