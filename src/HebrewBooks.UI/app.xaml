<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="HebrewBooks.UI.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ui1="clr-namespace:HebrewBooks.UI">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}">
        <Style.Triggers>
          <Trigger Property="DataGridCell.IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource HbSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HbSelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource HbSelectionForegroundBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <ItemsPanelTemplate x:Key="HitPagesPanel">
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
      <Style x:Key="HitPagePill" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="PillBorder" CornerRadius="10" Padding="10,3" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding StringFormat={x:Static res:SharedStrings.S9310}}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="PillBorder" Value="{DynamicResource ControlFillColorSecondaryBrush}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="PillBorder" Value="{DynamicResource HbSelectionBrush}" Property="Border.Background" />
                  <Setter TargetName="PillBorder" Value="{DynamicResource HbSelectionBrush}" Property="Border.BorderBrush" />
                  <Setter TargetName="PillBorder" Value="{DynamicResource HbSelectionForegroundBrush}" Property="TextElement.Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnHitPagePillClicked" />
        <EventSetter Event="RequestBringIntoView" Handler="OnHitPagePillBringIntoView" />
      </Style>
      <Style x:Key="HitPagesStrip" TargetType="{x:Type ListBox}">
        <Setter Property="ItemsPanel" Value="{StaticResource HitPagesPanel}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource HitPagePill}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      </Style>
      <Style x:Key="HitPageComboItem" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnHitPageComboItemClicked" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>