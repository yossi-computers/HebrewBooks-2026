<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HebrewBooks.UI.Controls.SortFilterControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:beh="clr-namespace:HebrewBooks.UI.Behaviors" xmlns:controls="clr-namespace:HebrewBooks.UI.Controls" FlowDirection="{m:LangFlow}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Style.Triggers>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderBrush" Value="#00FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="CriterionRowStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="UIElement.Opacity" Value="0.45" />
            <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <ToggleButton Name="SortToggle" MinWidth="110" MaxWidth="240" Padding="7,5" Background="#00FFFFFF" BorderThickness="0" HorizontalContentAlignment="Stretch" ToolTip="{x:Static res:SharedStrings.SortTip}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Summary}" />
        <TextBlock Grid.Column="1" Text="▾" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6" />
      </Grid>
    </ToggleButton>
    <Popup Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" beh:PopupReopenGuard.Enabled="True" IsOpen="{Binding IsChecked, ElementName=SortToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SortToggle}" Opened="OnPopupOpened">
      <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" MinWidth="320" MaxWidth="380" FlowDirection="{m:LangFlow}">
        <StackPanel>
          <TextBlock Text="{x:Static res:SharedStrings.SortPopupTitle}" FontWeight="SemiBold" Margin="0,0,0,2" />
          <TextBlock Text="{x:Static res:SharedStrings.SortHint}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8" />
          <ItemsControl Name="CriteriaList" ItemsSource="{Binding Criteria}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource CriterionRowStyle}" IsEnabled="{Binding IsAvailable}" ToolTip="{Binding UnavailableNote}" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Rank}" />
                    </Border>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Opacity="0.75" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                      <Run Text="{Binding DirectionLabel, Mode=OneWay}" /> <Run FontWeight="SemiBold" Text="{Binding DirectionArrow, Mode=OneWay}" /></TextBlock>
                    <Button Grid.Column="3" Content="✕" Margin="8,0,0,0" Padding="5,0" FontSize="11" Background="#00FFFFFF" BorderThickness="0" ToolTip="{x:Static res:SharedStrings.SortRemoveTip}" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{x:Static res:SharedStrings.SortClear}" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="10,4" Command="{Binding ClearCommand}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>