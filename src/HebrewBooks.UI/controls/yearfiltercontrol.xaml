<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HebrewBooks.UI.Controls.YearFilterControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:beh="clr-namespace:HebrewBooks.UI.Behaviors" xmlns:controls="clr-namespace:HebrewBooks.UI.Controls" FlowDirection="{m:LangFlow}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Style.Triggers>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderBrush" Value="#00FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="PresetButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,4,6,0" />
        <Setter Property="FontSize" Value="12" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <ToggleButton Name="YearToggle" MinWidth="110" MaxWidth="200" Padding="7,5" Background="#00FFFFFF" BorderThickness="0" HorizontalContentAlignment="Stretch" ToolTip="{x:Static res:SharedStrings.YearFilterTip}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Summary}" />
        <TextBlock Grid.Column="1" Text="▾" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6" />
      </Grid>
    </ToggleButton>
    <Popup Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" beh:PopupReopenGuard.Enabled="True" IsOpen="{Binding IsChecked, ElementName=YearToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=YearToggle}" Opened="OnPopupOpened">
      <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" MinWidth="340" MaxWidth="400" FlowDirection="{m:LangFlow}">
        <StackPanel>
          <TextBlock Text="{x:Static res:SharedStrings.YearFilterTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:SharedStrings.YearFilterFrom}" Opacity="0.75" Margin="0,0,0,3" />
            <ui:TextBox Name="FromBox" Grid.Row="1" Grid.Column="0" Padding="8,4" beh:SelectAllOnFocus.Enabled="True" Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged, Delay=250}" PreviewKeyDown="OnBoxKeyDown" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:SharedStrings.YearFilterBadInput}" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding HasFromError, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static res:SharedStrings.YearFilterTo}" Opacity="0.75" Margin="0,0,0,3" />
            <ui:TextBox Name="ToBox" Grid.Row="1" Grid.Column="2" Padding="8,4" beh:SelectAllOnFocus.Enabled="True" Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged, Delay=250}" PreviewKeyDown="OnBoxKeyDown" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{x:Static res:SharedStrings.YearFilterBadInput}" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding HasToError, Converter={StaticResource BoolToVis}}" />
          </Grid>
          <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding RangeEcho}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{x:Static res:SharedStrings.YearFilterInputHint}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,6,0,0" />
          <CheckBox Content="{x:Static res:SharedStrings.YearFilterUnknown}" ToolTip="{x:Static res:SharedStrings.YearFilterUnknownTip}" Margin="0,10,0,0" IsChecked="{Binding IncludeUnknown, Mode=TwoWay}" />
          <Separator Margin="0,10,0,6" Opacity="0.5" />
          <TextBlock Text="{x:Static res:SharedStrings.YearFilterPresetsTitle}" FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,2" />
          <WrapPanel Orientation="Horizontal">
            <Button Style="{StaticResource PresetButtonStyle}" Content="{x:Static res:SharedStrings.YearFilterPresetVeryOld}" CommandParameter="|5350" Command="{Binding PresetCommand}" />
            <Button Style="{StaticResource PresetButtonStyle}" Content="{x:Static res:SharedStrings.YearFilterPresetOld}" CommandParameter="|5600" Command="{Binding PresetCommand}" />
            <Button Style="{StaticResource PresetButtonStyle}" Content="{x:Static res:SharedStrings.YearFilterPresetMiddle}" CommandParameter="5600|5730" Command="{Binding PresetCommand}" />
            <Button Style="{StaticResource PresetButtonStyle}" Content="{x:Static res:SharedStrings.YearFilterPresetNew}" CommandParameter="5730|" Command="{Binding PresetCommand}" />
            <Button Style="{StaticResource PresetButtonStyle}" Content="{x:Static res:SharedStrings.YearFilterPresetRecent}" CommandParameter="5760|" Command="{Binding PresetCommand}" />
          </WrapPanel>
          <Button Content="{x:Static res:SharedStrings.YearFilterClear}" Margin="0,12,0,0" HorizontalAlignment="Left" Padding="10,4" Command="{Binding ClearCommand}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>