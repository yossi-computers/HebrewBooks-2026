<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HebrewBooks.UI.Controls.TopicFilterControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:HebrewBooks.UI.Resources" xmlns:m="clr-namespace:HebrewBooks.UI.Markup" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:beh="clr-namespace:HebrewBooks.UI.Behaviors" xmlns:controls="clr-namespace:HebrewBooks.UI.Controls" FlowDirection="{m:LangFlow}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <Style x:Key="SuggestionItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>
      <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Style.Triggers>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderBrush" Value="#00FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <ToggleButton Name="TopicToggle" MinWidth="110" MaxWidth="200" Padding="7,5" Background="#00FFFFFF" BorderThickness="0" HorizontalContentAlignment="Stretch" ToolTip="{x:Static res:SharedStrings.S5}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Summary}" />
        <TextBlock Grid.Column="1" Text="▾" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6" />
      </Grid>
    </ToggleButton>
    <Popup Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" beh:PopupReopenGuard.Enabled="True" IsOpen="{Binding IsChecked, ElementName=TopicToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=TopicToggle}" Opened="OnPopupOpened">
      <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" MinWidth="320" MaxWidth="380">
        <StackPanel>
          <ui:TextBox Name="SearchBox" Padding="8,4" PlaceholderText="{x:Static res:SharedStrings.S6}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=80}" PreviewKeyDown="OnSearchBoxKeyDown" />
          <ListBox Name="SuggestionsList" ItemContainerStyle="{StaticResource SuggestionItemStyle}" MaxHeight="220" Margin="0,6,0,0" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemsSource="{Binding Suggestions}" Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}" PreviewMouseLeftButtonDown="OnSuggestionPreviewMouseDown">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
          <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Selected}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource AccentFillColorTertiaryBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="0,4,4,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                    <Button Content="✕" Margin="6,0,0,0" Padding="4,0" FontSize="11" Background="#00FFFFFF" BorderThickness="0" ToolTip="{x:Static res:SharedStrings.S7}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{x:Static res:SharedStrings.S8}" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="10,4" Command="{Binding ClearCommand}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>